#%RAML 1.0 ResourceType

post?:
  body:
    application/json:
      type: <<postRequestType>>
      example: <<postExample>>
  responses:
    201:
      body:
        application/json:
          type: <<postResponseType>>

get?:
  responses:
    200:
      body:
        application/json:
          type: <<getResponseType>>
          example: <<getExample>>